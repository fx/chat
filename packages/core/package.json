{
  "name": "@fx-/chat-core",
  "version": "0.1.1",
  "description": "Renderer-agnostic core of @fx-/chat: message model, transcript logic, completion contract, and DOM-free React hooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fx/chat.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/fx/chat#readme",
  "bugs": {
    "url": "https://github.com/fx/chat/issues"
  }
}
