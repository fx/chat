{
  "name": "@fx-/chat",
  "version": "0.1.2",
  "description": "Framework-light, design-system-agnostic React components for rendering and composing LLM chat conversations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/structure.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./structure.css": "./src/structure.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@fx-/chat-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fx/chat.git",
    "directory": "packages/chat"
  },
  "homepage": "https://github.com/fx/chat#readme",
  "bugs": {
    "url": "https://github.com/fx/chat/issues"
  }
}
