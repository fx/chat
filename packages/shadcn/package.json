{
  "name": "@fx-/chat-shadcn",
  "version": "0.0.0",
  "description": "A ready-made shadcn/ui look for @fx-/chat: component registry, classNames theme and Tailwind v4 design tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src/theme.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.6.0",
    "vaul": "1.1.2"
  },
  "peerDependencies": {
    "@fx-/chat": "workspace:*",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@fx-/chat": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fx/chat.git",
    "directory": "packages/shadcn"
  },
  "homepage": "https://github.com/fx/chat#readme",
  "bugs": {
    "url": "https://github.com/fx/chat/issues"
  }
}
