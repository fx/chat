{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "types": ["node"],
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["index.ts", "src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/test-helpers.tsx", "dist"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/agent" },
    { "path": "../../packages/ink" }
  ]
}
