{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@fx-/chat",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/chat/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/agent/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/ink/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/shadcn/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "packages/chat/src/index.ts" },
        {
          "type": "json",
          "path": "apps/mobile/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/mobile/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "apps/mobile/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fx-chat')].version"
        },
        {
          "type": "json",
          "path": "apps/tui/package.json",
          "jsonpath": "$.dependencies['@fx-/chat-agent']"
        },
        {
          "type": "json",
          "path": "apps/tui/package.json",
          "jsonpath": "$.dependencies['@fx-/chat-core']"
        },
        {
          "type": "json",
          "path": "apps/tui/package.json",
          "jsonpath": "$.dependencies['@fx-/chat-ink']"
        }
      ]
    }
  }
}
