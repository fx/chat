{
  "name": "@fx/chat-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*", "demos/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '@fx/chat-core' build && bun run --filter '@fx/chat' --filter '@fx/chat-agent' --filter '@fx/chat-ink' build && bun run --filter '@fx/chat-shadcn' build",
    "prebuild:demo": "bun run build",
    "build:demo": "bun run --filter 'chat-demo' build",
    "typecheck": "tsc --build && tsc -p tsconfig.tools.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "pretest": "bun run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:no-internal-refs": "bun scripts/check-no-internal-refs.mjs",
    "check:registry-imports": "bun scripts/check-registry-imports.mjs",
    "build:mobile": "bun run --filter 'chat-mobile' build",
    "prebuild:mobile": "bun run build",
    "android:build": "bun run --filter 'chat-mobile' android:build"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@fx/chat": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "fake-indexeddb": "6.2.5",
    "ink": "8.0.0",
    "ink-testing-library": "4.0.0",
    "jsdom": "25.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.9.6",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
