{
  "name": "@fx/chat-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*", "demos/*"],
  "scripts": {
    "build": "bun run --filter '@fx/chat' build",
    "build:demo": "bun run --filter 'chat-demo' build",
    "typecheck": "tsc --build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:no-internal-refs": "node scripts/check-no-internal-refs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@fx/chat": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsdown": "0.9.6",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
